# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & PostgreSQL Configuration (Phase 2)
# Obtain these from your Supabase Project Settings -> API.
# Browser-visible publishable variables (enforced by Row Level Security policies)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Twilio Verify Service Configuration (Phase 5.1 Mobile Phone OTP)
# Used server-side in server.ts to dispatch and verify SMS one-time passcodes
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_VERIFY_SERVICE_SID="VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Demo Admin Configuration (Phase 8.1.6 & 10)
# Server-side only: never prefix with VITE_ and never expose passwords to browser
DEMO_ADMIN_ENABLED="true"
DEMO_ADMIN_EMAIL="admin@gmail.com"
DEMO_ADMIN_PASSWORD="your_demo_admin_password"

