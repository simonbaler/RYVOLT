# =============================================================================
# RYVOLT Environment Configuration for Local Dev & Render Deployment
# =============================================================================

# Server & Runtime Configuration (Render automatically sets PORT)
NODE_ENV="production"
PORT=10000
HOST="0.0.0.0"

# GEMINI_API_KEY: Required for Gemini AI Resume Assistant & Voice Coach.
# In Render: Set in Environment Variables panel.
GEMINI_API_KEY="AIzaSy..."

# APP_URL: The public URL of the deployed application (e.g., https://ryvolt.onrender.com)
APP_URL="https://your-service.onrender.com"

# Supabase Authentication & PostgreSQL Configuration
# In Render: Set both VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in Environment Variables
# Note: Vite embeds VITE_* variables into client bundle during 'npm run build'.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Optional: Supabase Service Role Key (server-side only, for automated admin role assignment)
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Twilio Verify Service Configuration (Mobile Phone OTP Verification)
# If not configured, RYVOLT runs in seamless dev-simulation mode (OTP shown in UI).
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_VERIFY_SERVICE_SID="VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Demo Admin Configuration
# Allows one-click demo login for the platform administrator role.
DEMO_ADMIN_ENABLED="true"
DEMO_ADMIN_EMAIL="admin@gmail.com"
DEMO_ADMIN_PASSWORD="your_demo_admin_password"

# Optional: Server Bootstrap Secret (for initial admin elevation endpoint)
# ADMIN_BOOTSTRAP_SECRET="your_bootstrap_secret_token"
